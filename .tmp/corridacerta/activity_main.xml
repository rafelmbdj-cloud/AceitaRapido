<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#174EA6"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORRIDA CERTA"
                android:textColor="#DCE8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Análise de corridas"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rapidocar • 99 • Uber"
                android:textColor="#DCE8FF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/statusBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF4E5"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/statusDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#F79009"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verificando leitura..."
                        android:textColor="#101828"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="A acessibilidade precisa estar ativa."
                        android:textColor="#667085"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/accessibilityButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E8F0FE"
                android:minHeight="50dp"
                android:text="ATIVAR LEITURA DAS CORRIDAS"
                android:textColor="#174EA6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/testOverlayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2563EB"
                android:minHeight="50dp"
                android:text="TESTAR FAIXA DO CORRIDA CERTA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mostra por 5 segundos a faixa escura escrita CORRIDA CERTA com o semáforo. Assim você sabe qual faixa é deste aplicativo."
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minhas regras"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Você pode mudar os valores quando quiser."
                android:textColor="#667085"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NORMAL — mínimo por km"
                android:textColor="#B54708"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/goodRateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:backgroundTint="#F79009"
                android:hint="Ex.: 1,70"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="#101828"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abaixo desse valor, a oferta será marcada como ruim."
                android:textColor="#98A2B3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="EXCELENTE — mínimo por km"
                android:textColor="#027A48"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/excellentRateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:backgroundTint="#12B76A"
                android:hint="Ex.: 2,50"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="#101828"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A partir desse valor, a faixa da oferta ficará verde."
                android:textColor="#98A2B3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Custo do carro por km"
                android:textColor="#344054"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/costPerKmInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:backgroundTint="#2563EB"
                android:hint="Ex.: 0,80"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="#101828"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usado para estimar o lucro líquido da corrida."
                android:textColor="#98A2B3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lucro líquido mínimo"
                android:textColor="#344054"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/minProfitInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:backgroundTint="#2563EB"
                android:hint="Ex.: 8,00"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="#101828"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajuda a evitar ofertas que deixam pouco retorno."
                android:textColor="#98A2B3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Som e avisos"
                android:textColor="#101828"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/voiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Falar a análise em voz alta"
                android:textColor="#344054"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A faixa deste app é escura, escrita CORRIDA CERTA e tem um semáforo pequeno: vermelho, amarelo ou verde."
                android:textColor="#98A2B3"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:backgroundTint="#2563EB"
            android:minHeight="56dp"
            android:text="SALVAR MINHAS REGRAS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="22dp"
            android:gravity="center"
            android:text="Corrida Certa • versão 0.5 de teste
Você continua decidindo se aceita ou recusa a corrida."
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
